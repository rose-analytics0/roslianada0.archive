:root{--sage:#DCE9DC;--mint:#EFF4EC;--off:#FAFAF6;--ink:#242824;--red:#A94444;--green:#315447;--muted:#6b756d;--r:16px}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--off);color:var(--ink);font:17px/1.7 Inter,system-ui,-apple-system,"Segoe UI",sans-serif}
h1,h2,h3{font-family:"Playfair Display",Georgia,serif;font-weight:600;line-height:1.2;color:var(--green)}
h1{font-size:clamp(34px,5vw,48px)}h2{font-size:clamp(26px,3.4vw,32px)}h3{font-size:22px}
a{color:inherit;text-decoration:none}
ul{list-style:none}
.wrap{max-width:1200px;margin:0 auto;padding:0 clamp(20px,4.5vw,56px)}
.topbar{border-bottom:1px solid #e3e7e0;font-size:13px;color:var(--muted)}
.topbar .wrap{display:flex;gap:28px;align-items:center;padding-top:7px;padding-bottom:7px;white-space:nowrap;overflow-x:auto}
.topbar span{display:inline-flex;align-items:center;gap:7px}
.topbar svg{width:14px;height:14px;stroke:var(--muted);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
nav.main{position:sticky;top:0;z-index:20;background:rgba(250,250,246,.94);backdrop-filter:blur(8px);border-bottom:1px solid #e3e7e0}
nav.main .wrap{display:flex;align-items:center;justify-content:space-between;height:68px}
.brand{display:flex;align-items:center;gap:10px;font-family:"Playfair Display",Georgia,serif;font-weight:700;color:var(--green);font-size:20px;letter-spacing:.04em}
.brand img{width:44px;height:44px;border-radius:50%;object-fit:cover}
.links{display:flex;gap:26px;font-size:15px}
.links a{padding:6px 0;border-bottom:2px solid transparent;transition:.2s}
.links a:hover{color:var(--green)}
.links a.active{color:var(--green);border-color:var(--red);font-weight:600}
.burger{display:none;background:none;border:1px solid #cfd8cf;border-radius:10px;width:44px;height:44px;cursor:pointer}
.burger span{display:block;width:20px;height:2px;background:var(--ink);margin:4px auto;transition:.25s}
.burger.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
.btn{display:inline-block;background:var(--green);color:#fff;padding:13px 28px;border-radius:999px;font-weight:600;font-size:15px;transition:.2s;border:0;cursor:pointer}
.btn:hover{background:var(--red);transform:translateY(-2px)}
.btn.ghost{background:transparent;color:var(--green);border:1.5px solid var(--green)}
.btn.ghost:hover{color:#fff}
.hero{padding:72px 0 88px}
.hero .wrap{display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center}
.eyebrow{color:var(--red);font-weight:600;font-size:14px;letter-spacing:.14em;text-transform:uppercase;margin-bottom:14px}
.hero .role{font-family:"Playfair Display",Georgia,serif;font-size:clamp(20px,2.6vw,26px);color:var(--ink);margin:14px 0 8px}
.hero .fields{color:var(--muted);font-size:16px}
.hero .tag{max-width:560px;margin:22px 0 32px;font-size:18px}
.cover{position:relative;border-radius:var(--r);background:var(--sage);aspect-ratio:4/5;overflow:hidden}
.cover>img.bg{width:100%;height:100%;object-fit:cover}
.cover .logo{position:absolute;left:20px;bottom:20px;width:104px;height:104px;border-radius:50%;border:4px solid var(--off);object-fit:cover;background:var(--off)}
section.panel{padding:96px 0}
.s-sage{background:var(--sage)}.s-mint{background:var(--mint)}
.head{display:flex;gap:20px;align-items:baseline;margin-bottom:28px}
.num{font-family:"Playfair Display",Georgia,serif;font-size:44px;color:var(--red);line-height:1;border-bottom:2px solid var(--red);padding-bottom:6px}
.kicker{font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
.intro{max-width:760px;margin-bottom:36px}
.page-title{margin:64px 0 8px}
.page-sub{max-width:760px;color:var(--muted);margin-bottom:8px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.stat{background:var(--off);border-radius:var(--r);padding:26px 24px}
.stat b{display:block;font-family:"Playfair Display",Georgia,serif;font-size:clamp(28px,3.2vw,38px);color:var(--green);line-height:1.1}
.stat small{display:block;margin-top:8px;font-size:14px;color:var(--muted);line-height:1.5}
.big{display:flex;align-items:baseline;gap:18px;flex-wrap:wrap;margin-bottom:12px}
.big b{font-family:"Playfair Display",Georgia,serif;font-size:clamp(48px,7vw,84px);color:var(--green);line-height:1}
.big span{font-size:18px;color:var(--muted)}
.line{height:2px;background:linear-gradient(90deg,var(--red) 0 22%,#c9d6c9 22% 100%);margin:26px 0;max-width:760px}
.three{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{background:var(--off);border-radius:var(--r);padding:28px}
.card h3{font-size:20px;margin-bottom:10px}
.card p,.card li{font-size:16px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:22px}
.pill{display:inline-block;font-size:13px;background:var(--mint);border-radius:999px;padding:3px 12px;margin:3px 6px 3px 0;color:var(--green)}
.list li{padding:9px 0 9px 22px;position:relative;border-bottom:1px solid #e3e7e0;font-size:16px}
.list li:last-child{border:0}
.list li:before{content:"";position:absolute;left:0;top:19px;width:8px;height:8px;border-radius:50%;background:var(--red)}
.group-t{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--red);font-weight:600;margin:14px 0 2px}
.tools{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.tools .card{background:#fff;border:1px solid #e3e7e0}
.tools h3{font-size:19px}
.tools h4{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin:14px 0 6px}
.tools li{font-size:15px;line-height:1.55;padding:2px 0}
footer{background:var(--green);color:#e8efe8;padding:64px 0 28px;text-align:center}
footer .btn{background:var(--off);color:var(--green)}
footer .btn:hover{background:var(--red);color:#fff}
footer p{margin-top:40px;font-size:14px;opacity:.8}
@media(max-width:1024px){.hero .wrap{grid-template-columns:1fr 1fr;gap:32px}.stats{grid-template-columns:repeat(2,1fr)}.tools,.three{grid-template-columns:1fr 1fr}.links{gap:16px;font-size:14px}}
@media(max-width:860px){.burger{display:block}
.links{position:absolute;left:0;right:0;top:68px;flex-direction:column;gap:0;background:var(--off);border-bottom:1px solid #e3e7e0;max-height:0;overflow:hidden;transition:max-height .3s}
.links.open{max-height:80vh;overflow:auto}
.links a{padding:15px 24px;border-bottom:1px solid #eef1ec;font-size:16px}
.links a.active{border-color:#eef1ec;border-left:3px solid var(--red)}
.hero{padding:40px 0 56px}.hero .wrap{grid-template-columns:1fr}.cover{order:-1;aspect-ratio:16/10}
section.panel{padding:64px 0}.two,.three,.tools{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}
.topbar .wrap{gap:18px;font-size:12px}}
@media(max-width:420px){.stats{grid-template-columns:1fr}.btn{width:100%;text-align:center}}
